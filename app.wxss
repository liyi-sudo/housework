page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  background: #ff5000;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0;
  line-height: 84rpx;
}

.btn-danger {
  background: #fff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: 44rpx;
}

.btn-plain {
  background: #fff;
  color: #333;
  border: 1rpx solid #ddd;
  border-radius: 44rpx;
}

.price {
  color: #ff5000;
  font-weight: 700;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #ff5000;
}

.input {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}