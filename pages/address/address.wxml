<view class="page">
  <view class="card addr" wx:for="{{list}}" wx:key="id">
    <view class="main">
      <view>
        <text class="name">{{item.receiverName}}</text>
        <text class="phone">{{item.receiverPhone}}</text>
        <text class="tag" wx:if="{{item.isDefault === 1}}">默认</text>
      </view>
      <view class="detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view>
    </view>
    <view class="ops" catchtap="stopProp">
      <text wx:if="{{item.isDefault !== 1}}" data-id="{{item.id}}" bindtap="setDefault">设为默认</text>
      <text data-id="{{item.id}}" bindtap="openEdit">编辑</text>
      <text data-id="{{item.id}}" bindtap="remove" style="color:#ff5000;">删除</text>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">暂无地址，点击下方添加</view>

  <button class="btn-primary add-btn" bindtap="openAdd">+ 新增地址</button>

  <view class="mask" wx:if="{{showForm}}" bindtap="hideForm">
    <view class="form" catchtap="stopProp">
      <view class="title">{{editingId ? '编辑地址' : '新增地址'}}</view>
      <view class="row">
        <text class="label">收货人</text>
        <input class="input" data-field="receiverName" value="{{form.receiverName}}" bindinput="onField" />
      </view>
      <view class="row">
        <text class="label">手机号</text>
        <input class="input" type="number" data-field="receiverPhone" value="{{form.receiverPhone}}" bindinput="onField" />
      </view>
      <view class="row">
        <text class="label">省份</text>
        <input class="input" placeholder="如 浙江省" data-field="province" value="{{form.province}}" bindinput="onField" />
      </view>
      <view class="row">
        <text class="label">城市</text>
        <input class="input" placeholder="如 杭州市" data-field="city" value="{{form.city}}" bindinput="onField" />
      </view>
      <view class="row">
        <text class="label">区县</text>
        <input class="input" placeholder="如 西湖区" data-field="district" value="{{form.district}}" bindinput="onField" />
      </view>
      <view class="row">
        <text class="label">详细地址</text>
        <input class="input" placeholder="街道门牌号等" data-field="detail" value="{{form.detail}}" bindinput="onField" />
      </view>
      <view class="row">
        <text class="label">设为默认</text>
        <switch checked="{{form.isDefault === 1}}" bindchange="toggleDefault" color="#ff5000" />
      </view>
      <button class="btn-primary" bindtap="save" style="height:88rpx;line-height:88rpx;margin-top:20rpx;">保存</button>
    </view>
  </view>
</view>