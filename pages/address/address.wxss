.page {
  padding: 24rpx 24rpx 160rpx;
}
.addr {
  margin-bottom: 20rpx;
}
.name {
  font-weight: 700;
  margin-right: 16rpx;
}
.phone {
  color: #666;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.tag {
  background: #ff5000;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.detail {
  color: #666;
  font-size: 26rpx;
  margin-top: 10rpx;
}
.ops {
  display: flex;
  justify-content: flex-end;
  gap: 40rpx;
  margin-top: 16rpx;
  color: #666;
  font-size: 26rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
.add-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.form {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 30rpx;
}
.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.label {
  width: 160rpx;
  font-size: 28rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
}