  height: 200rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}
.tips {
  color: #999;
  font-size: 24rpx;
  margin: 30rpx 0;
  line-height: 1.7;
}