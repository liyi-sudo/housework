.page {
  padding: 24rpx;
  padding-bottom: 160rpx;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.cart-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.cart-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
}
.sub {
  color: #999;
  font-size: 24rpx;
  margin: 8rpx 0;
}
.qty {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.total {
  font-size: 30rpx;
}
.pay-btn {
  width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
}