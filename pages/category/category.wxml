<view class="page">
  <view class="side">
    <view wx:for="{{parents}}" wx:key="id" class="parent {{activeId === item.id ? 'on' : ''}}"
          data-id="{{item.id}}" bindtap="onSelect">
      {{item.name}}
    </view>
  </view>
  <view class="main">
    <view class="goods-grid">
      <view class="goods-item" wx:for="{{goodsList}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoodsTap">
        <image class="goods-img" src="{{item.mainImage}}" mode="aspectFill" />
        <view class="goods-name">{{item.name}}</view>
        <view class="price">¥{{item.price}}</view>
      </view>
    </view>
    <view wx:if="{{!goodsList.length}}" class="empty">该分类暂无商品</view>
    <view class="load-more" bindtap="onLoadMore" wx:if="{{goodsList.length < total}}">加载更多</view>
  </view>
</view>
