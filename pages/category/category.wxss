.page {
  display: flex;
  height: 100vh;
}
.side {
  width: 180rpx;
  background: #f7f7f7;
  overflow-y: auto;
}
.parent {
  padding: 32rpx 20rpx;
  font-size: 26rpx;
  text-align: center;
}
.parent.on {
  background: #fff;
  color: #ff5000;
  font-weight: 700;
  border-left: 8rpx solid #ff5000;
}
.main {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.goods-item {
  width: 48%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 12rpx;
}
.goods-img {
  width: 100%;
  height: 260rpx;
  border-radius: 10rpx;
}
.goods-name {
  font-size: 24rpx;
  margin: 8rpx 0 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
.load-more {
  text-align: center;
  color: #999;
  padding: 20rpx;
}
