.page {
  padding: 24rpx 24rpx 180rpx;
}
.addr {
  position: relative;
}
.addr-title {
  font-weight: 700;
  margin-bottom: 12rpx;
}
.addr-item {
  border: 2rpx solid #fff;
  padding: 10rpx 0;
}
.addr-item.on {
  border-color: #ff5000;
  background: #fff7f3;
  border-radius: 12rpx;
  padding: 10rpx;
}
.addr-ops {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}
.add-addr {
  color: #ff5000;
  font-weight: 700;
}
.manage-addr {
  color: #666;
}
.name {
  font-weight: 700;
  margin-right: 20rpx;
}
.phone {
  color: #999;
  font-size: 26rpx;
}
.detail {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.empty {
  color: #999;
  text-align: center;
  padding: 30rpx 0;
}
.item {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
}
.sub {
  color: #999;
  font-size: 24rpx;
  margin-top: 6rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.pay {
  font-size: 28rpx;
}
.pay-btn {
  width: 260rpx;
  height: 80rpx;
  line-height: 80rpx;
}