.page {
  padding: 24rpx;
}
.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
}
.tab.on {
  color: #ff5000;
  font-weight: 700;
  border-bottom: 4rpx solid #ff5000;
}
.coupon {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.amount {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff5000;
}
.threshold {
  font-size: 24rpx;
  color: #ff5000;
}
.sub {
  color: #999;
  font-size: 22rpx;
  margin-top: 6rpx;
}
.right {
  color: #999;
  font-size: 24rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}
.claimable-section {
  margin-bottom: 24rpx;
}
.claimable-section .section-title {
  margin-bottom: 16rpx;
}
.claim-btn {
  padding: 12rpx 28rpx;
  background: #ff5000;
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.claim-btn.done {
  background: #ddd;
  color: #999;
}
.empty-sm {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}