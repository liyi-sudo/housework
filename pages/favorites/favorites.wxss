.page {
  padding: 24rpx;
}
.card {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 20rpx;
}
.img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
}
.name {
  font-size: 28rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.sub {
  color: #999;
  font-size: 22rpx;
  margin: 6rpx 0;
}
.price-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.del {
  color: #ff5000;
  font-size: 24rpx;
  padding: 8rpx 0 8rpx 30rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 100rpx 0 40rpx;
}
