.page {
  padding-bottom: 160rpx;
}
.gallery {
  height: 620rpx;
}
.gallery-img {
  width: 100%;
  height: 100%;
}
.info {
  margin: 0 24rpx 20rpx;
}
.price {
  font-size: 44rpx;
}
.pad {
  padding-bottom: 8rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 8rpx 0;
}
.sub {
  color: #999;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.meta {
  color: #999;
  font-size: 24rpx;
}
.sku,
.reviews {
  margin: 0 24rpx 20rpx;
}
.sku-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sku {
  padding: 16rpx 26rpx;
  border: 2rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.sku.on {
  border-color: #ff5000;
  color: #ff5000;
  background: #fff7f3;
}
.review {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.nick {
  font-weight: 700;
  font-size: 26rpx;
}
.content {
  font-size: 28rpx;
  margin-top: 10rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.fav {
  width: 100rpx;
  text-align: center;
}
.fav-text {
  font-size: 20rpx;
  color: #666;
}
.cart-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-color: #ff5000;
  color: #ff5000;
}
.buy-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
}
.sheet {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.sheet-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}
.qty-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 30rpx 0;
}
.sheet-ok {
  height: 88rpx;
  line-height: 88rpx;
}
.review-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.write-review {
  font-size: 26rpx;
  color: #ff5000;
  font-weight: 700;
}
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.review-form {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}
.review-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}
.rating-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.star {
  font-size: 56rpx;
  color: #ddd;
}
.star.on {
  color: #ff8000;
}
.review-textarea {
  width: 100%;
  height: 180rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}
.review-ok {
  height: 84rpx;
  line-height: 84rpx;
}