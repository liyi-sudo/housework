<view class="page">
  <view class="sort-bar card">
    <view wx:for="{{sorts}}" wx:key="key" class="sort {{sort === item.key ? 'on' : ''}}"
          data-key="{{item.key}}" bindtap="changeSort">{{item.label}}</view>
  </view>

  <view class="goods-grid card">
    <view class="goods-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoodsTap">
      <image class="goods-img" src="{{item.mainImage}}" mode="aspectFill" />
      <view class="goods-name">{{item.name}}</view>
      <view class="price">¥{{item.price}}</view>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">没有找到相关商品</view>
</view>