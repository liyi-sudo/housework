.page {
  padding: 24rpx;
}
.sort-bar {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 24rpx;
}
.sort {
  font-size: 26rpx;
  color: #666;
}
.sort.on {
  color: #ff5000;
  font-weight: 700;
}
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 16rpx;
}
.goods-item {
  width: 48%;
  margin-bottom: 20rpx;
}
.goods-img {
  width: 100%;
  height: 330rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
}
.goods-name {
  font-size: 26rpx;
  margin: 10rpx 0 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}