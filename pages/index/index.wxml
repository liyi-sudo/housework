<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索商品" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
  </view>

  <view class="notice" wx:if="{{notices.length}}" bindtap="onNoticeTap">
    <text class="notice-tag">公告</text>
    <view class="notice-body">
      <view class="notice-content {{showNotice ? 'show' : ''}}" wx:if="{{notices[noticeIdx].content}}">{{notices[noticeIdx].content}}</view>
    </view>
  </view>

  <swiper class="banner" indicator-dots autoplay circular current="{{current}}" bindchange="onSwiperChange" wx:if="{{banners.length}}">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner-img" src="{{item.image}}" data-link="{{item.link}}" bindtap="onBannerTap" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="cat-grid card">
    <view class="cat-item" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="onCategoryTap">
      <view class="cat-avatar">{{item.name[0]}}</view>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </view>

  <view class="coupon-strip card" bindtap="goCoupons">
    <view class="coupon-icon">¥</view>
    <text class="coupon-text">新人专享 · 领券下单更划算</text>
    <view class="coupon-btn">去领券 ›</view>
  </view>

  <view class="card">
    <view class="section-title">精选推荐</view>
    <view class="goods-grid">
      <view class="goods-item" wx:for="{{goodsList}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoodsTap">
        <image class="goods-img" src="{{item.mainImage}}" mode="aspectFill" />
        <view class="goods-name">{{item.name}}</view>
        <view class="price">¥{{item.price}}</view>
      </view>
    </view>
  </view>
</view>