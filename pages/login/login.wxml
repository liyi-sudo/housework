<view class="page">
  <view class="logo">优选商城</view>
  <view class="tip">网页端 / 小程序共用同一账号</view>

  <view class="card form">
    <view class="tabs">
      <view class="tab {{mode === 'password' ? 'on' : ''}}" data-mode="password" bindtap="switchMode">密码登录</view>
      <view class="tab {{mode === 'code' ? 'on' : ''}}" data-mode="code" bindtap="switchMode">验证码登录</view>
    </view>

    <input class="input" type="number" maxlength="11" placeholder="手机号" value="{{phone}}" bindinput="onPhone" />

    <input wx:if="{{mode === 'password'}}" class="input" password placeholder="密码" value="{{password}}" bindinput="onPassword" />

    <view wx:else class="code-row">
      <input class="input code-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{code}}" bindinput="onCode" />
      <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </view>
    </view>

    <button class="btn-primary" disabled="{{loading}}" bindtap="doLogin">{{loading ? '登录中...' : '登录'}}</button>
    <view class="reg" bindtap="goRegister">没有账号？立即注册</view>
  </view>
</view>
