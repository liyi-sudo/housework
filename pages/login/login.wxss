.page {
  padding: 60rpx 40rpx;
}
.logo {
  text-align: center;
  font-size: 56rpx;
  font-weight: 800;
  color: #ff5000;
  margin-bottom: 12rpx;
}
.tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin-bottom: 48rpx;
}
.tabs {
  display: flex;
  border-bottom: 2rpx solid #eee;
  margin-bottom: 32rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
}
.tab.on {
  color: #ff5000;
  font-weight: 700;
  border-bottom: 4rpx solid #ff5000;
}
.input {
  margin-bottom: 24rpx;
}
.code-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.code-input {
  flex: 1;
  margin-bottom: 0;
}
.code-btn {
  width: 200rpx;
  text-align: center;
  line-height: 84rpx;
  border: 2rpx solid #ff5000;
  color: #ff5000;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #fff;
}
.code-btn.disabled {
  border-color: #ddd;
  color: #999;
  background: #f5f5f5;
}
.reg {
  text-align: center;
  color: #ff5000;
  font-size: 26rpx;
  margin-top: 40rpx;
}
