.page {
  padding: 24rpx;
}
.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
}
.nick {
  font-size: 34rpx;
  font-weight: 700;
}
.phone {
  color: #999;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.logout {
  color: #999;
  font-size: 24rpx;
}
.stats {
  display: flex;
}
.stat {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
}
.num {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff5000;
}
.label {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}
.menu-item {
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}