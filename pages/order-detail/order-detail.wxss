.page {
  padding: 24rpx 24rpx 200rpx;
}
.status-card {
  text-align: center;
  padding: 50rpx 0;
}
.status {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff5000;
}
.item {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
}
.sub {
  color: #999;
  font-size: 24rpx;
}
.name {
  font-weight: 700;
  margin-right: 20rpx;
}
.phone {
  color: #999;
}
.detail {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #666;
}
.total {
  border-top: 1rpx solid #f5f5f5;
  margin-top: 10rpx;
  padding-top: 16rpx;
}
.trace {
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 0;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.btn {
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 26rpx;
  padding: 0 34rpx;
  background: #fff;
}
.btn.primary {
  background: #ff5000;
  color: #fff;
  border-color: #ff5000;
}