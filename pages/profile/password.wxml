<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">原密码</text>
      <input class="input" password value="{{oldPassword}}" bindinput="onOld" placeholder="请输入原密码" />
    </view>
    <view class="field">
      <text class="label">新密码</text>
      <input class="input" password value="{{newPassword}}" bindinput="onNew" placeholder="至少 6 位" />
    </view>
    <view class="field">
      <text class="label">确认新密码</text>
      <input class="input" password value="{{confirm}}" bindinput="onConfirm" placeholder="再次输入新密码" />
    </view>
    <view class="save-btn" bindtap="save">{{submitting ? '提交中...' : '确认修改'}}</view>
  </view>
</view>
