<view class="page">
  <view class="card">
    <view class="avatar-wrap">
      <image class="avatar" src="{{avatar || 'https://loremflickr.com/100/100/portrait?lock=950'}}" mode="aspectFill" />
      <text class="phone">{{phone}}</text>
    </view>
    <view class="field">
      <text class="label">昵称</text>
      <input class="input" value="{{nickname}}" bindinput="onNickname" placeholder="请输入昵称" />
    </view>
    <view class="field">
      <text class="label">性别</text>
      <view class="gender-row">
        <view wx:for="{{genders}}" wx:key="value"
              class="gender {{gender === item.value ? 'on' : ''}}"
              data-value="{{item.value}}" bindtap="selectGender">{{item.label}}</view>
      </view>
    </view>
    <view class="save-btn" bindtap="save">保存</view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goPassword">
      <text>修改密码</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
