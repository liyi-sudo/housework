.page {
  padding: 24rpx;
}
.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f0f0f0;
}
.phone {
  color: #999;
  font-size: 24rpx;
  margin-top: 12rpx;
}
.field {
  margin-bottom: 24rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.input {
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
}
.gender-row {
  display: flex;
  gap: 20rpx;
}
.gender {
  padding: 14rpx 40rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
}
.gender.on {
  border-color: #ff5000;
  color: #ff5000;
  background: #fff7f3;
}
.save-btn {
  background: #ff5000;
  color: #fff;
  text-align: center;
  padding: 22rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  margin-top: 12rpx;
}
.menu {
  margin-top: 24rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 8rpx;
  font-size: 28rpx;
}
.arrow {
  color: #ccc;
  font-size: 30rpx;
}
