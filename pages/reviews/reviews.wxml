<view class="page">
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="head">
      <text style="color:#ff8000;">{{item.starText}}</text>
      <text class="date">{{item.createTime}}</text>
    </view>
    <view class="content">{{item.content}}</view>
    <view class="sub" wx:if="{{item.reply}}">商家回复：{{item.reply}}</view>
    <view class="follow-bar">
      <text wx:if="{{item.followUp}}" class="followed">已追评</text>
      <view wx:else class="follow-btn" data-id="{{item.id}}" bindtap="openFollow">追评</view>
    </view>
  </view>
  <view wx:if="{{!list.length}}" class="empty">暂无评价</view>

  <view class="mask" wx:if="{{showFollow}}" bindtap="closeFollow">
    <view class="modal" catchtap="stopTap">
      <view class="modal-title">追加评价</view>
      <textarea class="textarea" value="{{followContent}}" bindinput="onFollowInput" maxlength="500"
                placeholder="说说使用后的感受…" ></textarea>
      <view class="modal-actions">
        <view class="btn-plain" bindtap="closeFollow">取消</view>
        <view class="btn-primary" bindtap="submitFollow">{{submitting ? '提交中...' : '提交追评'}}</view>
      </view>
    </view>
  </view>
</view>
