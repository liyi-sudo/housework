.page {
  padding: 24rpx;
}
.head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.date {
  color: #999;
  font-size: 24rpx;
}
.content {
  font-size: 28rpx;
}
.sub {
  color: #ff5000;
  font-size: 24rpx;
  margin-top: 10rpx;
}
.follow-bar {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.follow-btn {
  padding: 8rpx 30rpx;
  border: 2rpx solid #ff5000;
  color: #ff5000;
  background: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
}
.followed {
  color: #999;
  font-size: 26rpx;
}
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  position: relative;
  z-index: 200;
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.textarea {
  position: relative;
  z-index: 300;
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 28rpx;
}
.btn-plain {
  padding: 14rpx 40rpx;
  border: 2rpx solid #ddd;
  color: #666;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.btn-primary {
  padding: 14rpx 40rpx;
  background: #ff5000;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}